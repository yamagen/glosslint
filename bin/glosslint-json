#!/bin/sh

CONTROL="$1"
FILE="$2"

jq --stream -nr '
  foreach inputs as $x
    (
      { ids: {}, rec: {}, emit: null };

      .emit = null |
      ($x[0]) as $p |

      if (($x|length) == 2
          and ($p|length) == 2
          and $p[1] == "id")
      then
        .ids[($p[0]|tostring)] = ($x[1]|tostring)

      elif (($x|length) == 2
            and ($p|length) == 4
            and $p[1] == "word-gloss")
      then
        ($p[0]|tostring) as $i |
        ($p[2]|tostring) as $j |
        ($i + "|" + $j) as $k |
        ($p[3]) as $f |

        if $f == "word" then
          .rec[$k].word = ($x[1] // "")

        elif $f == "gloss" then
          .rec[$k].gloss = ($x[1] // "") |
          .rec[$k].line = input_line_number

        elif $f == "pos" then
          .rec[$k].pos = ($x[1] // "") |
          .emit = ([
            input_filename,
            (.rec[$k].line // input_line_number),
            (.ids[$i] // ""),
            (.rec[$k].word // ""),
            (.rec[$k].gloss // ""),
            (.rec[$k].pos // "")
          ] | @tsv)

        else
          .
        end
      else
        .
      end;

      .emit // empty
    )
' "$FILE" |
glosslint -c "$CONTROL" 2>/dev/null
